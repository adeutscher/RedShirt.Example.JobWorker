# Common IntelliJ Platform excludes

.idea/
# User specific
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/shelf/*
**/.idea/dictionaries
**/.idea/httpRequests/

# Sensitive or high-churn files
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.xml
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml

# Rider
# Rider auto-generates .iml files, and contentModel.xml
**/.idea/**/*.iml
**/.idea/**/contentModel.xml
**/.idea/**/modules.xml

*.suo
*.user
.vs/
[Bb]in/
[Oo]bj/
_UpgradeReport_Files/
[Pp]ackages/

Thumbs.db
Desktop.ini
.DS_Store

*.generated.cs

# Vim Swapfiles
.*.swp

# Env / local overrides
.env
.env.*
**/appsettings.*.local.json

# Test / coverage / package artifacts
[Tt]est[Rr]esults/
*.trx
coverage*
*.coverage
*.coveragexml
*.nupkg
*.snupkg
artifacts/
BenchmarkDotNet.Artifacts/
*.log

# Editor
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
